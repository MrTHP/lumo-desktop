{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Desk",
  "version": "0.4.0",
  "identifier": "me.mrthp.modeldesk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Model Desk",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Espace IA local-first : chat, agent et images Bonsai",
    "longDescription": "Espace de travail desktop Rust/Tauri pour Lumo Tamer, l'API DeepSeek, l'agent OpenCode et la génération d'images locale avec Bonsai Image.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
