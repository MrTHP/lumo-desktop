{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumo Desktop",
  "version": "0.1.0",
  "identifier": "me.mrthp.lumodesktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumo Desktop",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Client desktop pour Lumo via lumo-tamer",
    "longDescription": "Client de chat desktop pour Lumo, connecté à l'API OpenAI-compatible de lumo-tamer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
